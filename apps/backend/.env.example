# Copy these into Railway → your service → Variables.
# Never commit real values: the Lob key can spend money and the API token is
# what stops anyone else from mailing letters on the firm's account.

# --- required ---------------------------------------------------------------

# Lob secret key. test_... creates letters without printing or mailing anything;
# live_... prints and mails for real and is billed to the firm.
LOB_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the Word add-in sends as `Authorization: Bearer <token>`.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=

# The firm's return address, printed on the envelope.
RETURN_NAME=Benjamin J. Rooney
RETURN_COMPANY=Rooney Law
RETURN_ADDRESS_LINE1=
RETURN_ADDRESS_LINE2=
RETURN_ADDRESS_CITY=
RETURN_ADDRESS_STATE=IL
RETURN_ADDRESS_ZIP=

# --- optional ---------------------------------------------------------------

# Delivery tracking. Create a webhook in the Lob dashboard pointing at
# https://<your-app>.up.railway.app/webhooks/lob, then paste its signing secret
# here. Without it the webhook endpoint refuses every delivery (503) and the
# "Recent mail" panel shows no statuses.
#
# Lob keeps webhooks separate per environment, each with its own secret. To
# receive both test and live events, create a webhook in each and list both
# secrets separated by a comma:
#   LOB_WEBHOOK_SECRET=whsec_from_test,whsec_from_live
LOB_WEBHOOK_SECRET=

# Tracking events are held in memory and lost on restart. To keep them, attach a
# Railway volume and point this at a file on it, e.g. /data/lob-events.jsonl.
EVENT_LOG_PATH=
EVENT_MAX_RETAINED=500

# Check every recipient against USPS data before creating any letter, so one bad
# address cannot leave a half-mailed batch. Costs one Lob verification lookup per
# recipient and only works on a live key, so it is off by default. The "Check
# this address" button in the task pane works regardless of this setting.
VERIFY_BEFORE_SEND=false

# Lob's cancellation window, used only as a fallback for the countdown in the
# task pane; the real deadline comes from each letter's send_date.
LOB_CANCELLATION_WINDOW_MINUTES=5

# --- postage rates (optional) ------------------------------------------------
#
# Lob's API does not return a price for a letter, so the cost shown before
# sending is worked out from these rates. They are deliberately blank: Lob does
# not publish a fixed price list, and per-piece pricing depends on the account's
# Print & Mail Edition and volume. Take the real numbers off a Lob invoice or
# the pricing page in the dashboard.
#
# Leave RATE_BASE empty and no cost is shown anywhere — better than a guess
# that ends up on a client's bill.

# Price of a one-page black-and-white first-class letter.
RATE_BASE=
# Price of each page beyond RATE_INCLUDED_PAGES.
RATE_EXTRA_PAGE=
RATE_INCLUDED_PAGES=1

# Colour printing, if the firm ever uses it. Falls back to the mono rates.
RATE_COLOR_BASE=
RATE_COLOR_EXTRA_PAGE=

# Add-on fees. For reference, USPS's own certified fee was $5.55 and the
# electronic return receipt $2.91 as of July 2026 — but what Lob charges the
# firm is what belongs here.
RATE_CERTIFIED=
RATE_CERTIFIED_RETURN_RECEIPT=
RATE_REGISTERED=

# Set true if the plan prices per printed sheet rather than per page, so a
# double-sided letter counts two pages per sheet.
RATE_PRICE_PER_SHEET=false

RATE_CURRENCY=USD

# Where Lob prints the address block that shows through the envelope window.
#   insert_blank_page  (default) adds a separate address page, so nothing is
#                      printed over the letterhead. Costs one extra page.
#   top_first_page     prints the address over the top of page 1. Only use this
#                      if the letter template leaves the top ~2.5" blank.
# Certified and registered mail ignore this: Lob adds its own cover sheet.
DEFAULT_ADDRESS_PLACEMENT=insert_blank_page

DEFAULT_COLOR=false
DEFAULT_DOUBLE_SIDED=false

# Spend guardrails. A request is refused rather than partially mailed.
MAX_LETTERS_PER_HOUR=40
MAX_LETTERS_PER_DAY=120
MAX_FILE_BYTES=26214400

# USPS use type for the mailing. Legal correspondence is operational, not marketing.
LOB_USE_TYPE=operational

# Pin Lob's dated API version, e.g. 2024-01-01. Leave blank to use the account default.
LOB_API_VERSION=

# Only needed if the task pane is hosted somewhere other than this service.
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=

# Set to false to serve the API only (no /addin static files).
SERVE_ADDIN=true
