# Copy these into Railway → your service → Variables.
# Never commit real values: the Lob key can spend money and the API token is
# what stops anyone else from mailing letters on the firm's account.

# --- required ---------------------------------------------------------------

# Lob secret key. test_... creates letters without printing or mailing anything;
# live_... prints and mails for real and is billed to the firm.
LOB_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the Word add-in sends as `Authorization: Bearer <token>`.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=

# The firm's return address, printed on the envelope.
RETURN_NAME=Benjamin J. Rooney
RETURN_COMPANY=Rooney Law
RETURN_ADDRESS_LINE1=
RETURN_ADDRESS_LINE2=
RETURN_ADDRESS_CITY=
RETURN_ADDRESS_STATE=IL
RETURN_ADDRESS_ZIP=

# --- optional ---------------------------------------------------------------

# Where Lob prints the address block that shows through the envelope window.
#   insert_blank_page  (default) adds a separate address page, so nothing is
#                      printed over the letterhead. Costs one extra page.
#   top_first_page     prints the address over the top of page 1. Only use this
#                      if the letter template leaves the top ~2.5" blank.
# Certified and registered mail ignore this: Lob adds its own cover sheet.
DEFAULT_ADDRESS_PLACEMENT=insert_blank_page

DEFAULT_COLOR=false
DEFAULT_DOUBLE_SIDED=false

# Spend guardrails. A request is refused rather than partially mailed.
MAX_LETTERS_PER_HOUR=40
MAX_LETTERS_PER_DAY=120
MAX_FILE_BYTES=26214400

# USPS use type for the mailing. Legal correspondence is operational, not marketing.
LOB_USE_TYPE=operational

# Pin Lob's dated API version, e.g. 2024-01-01. Leave blank to use the account default.
LOB_API_VERSION=

# Only needed if the task pane is hosted somewhere other than this service.
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=

# Set to false to serve the API only (no /addin static files).
SERVE_ADDIN=true
