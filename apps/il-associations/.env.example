# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Railway PostgreSQL. Railway provides this automatically when you attach a
# Postgres service; reference it as ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=postgres://user:password@host:5432/railway

# Session signing key. At least 32 characters.
#   openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The application's public URL, e.g. https://il-associations.up.railway.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage — raw source files, exports and backups
# ---------------------------------------------------------------------------
# Large bytes never go into Postgres. Use "s3" in production; "local" writes
# under LOCAL_STORAGE_DIR and exists for development and tests only. On Railway
# the container filesystem is ephemeral, so "local" there loses uploads on
# redeploy.
STORAGE_DRIVER=s3

S3_BUCKET=il-associations
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for S3-compatible providers (Railway's bucket, Cloudflare R2, MinIO, …).
S3_ENDPOINT=
# Most S3-compatible providers need this set to true.
S3_FORCE_PATH_STYLE=false
# Key prefix inside the bucket.
S3_PREFIX=il-associations

# Used only when STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=.storage

# ---------------------------------------------------------------------------
# First administrator (first deploy only)
# ---------------------------------------------------------------------------
# The app is private and a fresh database has no accounts, so there would be no
# way in. When these are set, the migration step that runs before the server
# starts creates the first administrator. An existing account is never silently
# re-passworded; set BOOTSTRAP_ADMIN_FORCE=true to reset a forgotten password.
# Remove BOOTSTRAP_ADMIN_PASSWORD once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_FORCE=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Scheduled refresh is OFF by default and needs BOTH this variable and the
# in-app setting under Imports and updates. See the README.
ENABLE_SCHEDULED_REFRESH=false

# Largest single source file accepted by the upload wizard, in bytes.
MAX_UPLOAD_BYTES=536870912

# Connection pool sizes.
DB_POOL_MAX=8
DB_DRIZZLE_POOL_MAX=4

# Only used by `npm test` to enable the database integration suites. Point it
# at a database the tests may DROP and CREATE.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/il_assoc_test
